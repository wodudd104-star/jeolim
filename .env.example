# ===== 프론트엔드 빌드 환경변수 (Vite 빌드 시 주입) =====
# 로컬 개발 시 API 서버 주소 (빈 값이면 동일 출처로 /api 호출)
VITE_API_URL=http://localhost:3000

# 토스페이먼츠 클라이언트 키 (공개 브라우저 설정값)
# https://developers.tosspayments.com 에서 발급 (테스트 키 또는 라이브 키)
VITE_TOSS_CLIENT_KEY=your-client-key-here

# ===== 서버 런타임 환경변수 (서버에만 설정, 소스/빌드 산출물에 넣지 않음) =====
# 토스페이먼츠 시크릿 키 (서버 전용, 절대 프론트 코드에 넣지 않음)
TOSS_SECRET_KEY=

# 회원 데이터를 영구 저장할 PostgreSQL 주소
# 예: postgres://user:password@host:5432/dbname
# 값이 없으면 로컬 JSON 파일(src/lib/data)로 동작
DATABASE_URL=

# 문자 발송 (솔라피, https://solapi.com)
# 가입 후 API 키 발급 + 발신번호 등록 필요
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 일반 문자(SMS/LMS) 발송용 발신번호 (솔라피에 등록한 번호, 예: 01012345678)
SOLAPI_SENDER=
# 카카오 알림톡/친구톡을 쓰는 경우에만 채널 ID 입력 (비워두면 일반 문자로 발송)
SOLAPI_SENDER_KEY=

# 이메일 발송 (선택, Gmail 사용 시)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# 세션 서명 키 (미설정 시 서버 시작마다 랜덤 생성, 재시작 시 세션 초기화됨)
SESSION_SECRET=
