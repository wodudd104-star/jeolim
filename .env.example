# 로컬 개발 시 Render 서버 주소 (빈 값이면 동일 출처 /api/send-sms 호출)
VITE_API_URL=http://localhost:3000

# 회원 데이터를 영구 저장할 PostgreSQL 주소 (Render PostgreSQL 등)
# 예: postgres://user:password@host:5432/dbname
# 값이 없으면 로컬 data/auth.json 파일로 동작합니다.
DATABASE_URL=

# GitHub 자동 커밋 (선택사항)
# Render 등 파일 시스템이 초기화되는 환경에서 회원 데이터를 GitHub에 자동 저장하려면
# Classic Personal Access Token을 생성해서 등록하세요. (repo 권한 필요)
# GITHUB_REPO=wodudd104-star/jeolim-cabbage-orders
GITHUB_TOKEN=

# 문자 발송용 — 서버의 /opt/jeolim-cabbage/.env 파일에 입력
# 솔라피(solapi.com) 가입 후 API 키 발급 + 발신번호 등록 필요
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 일반 문자(SMS/LMS) 발송용 발신번호 (솔라피에 등록된 번호, 예: 01012345678)
SOLAPI_SENDER=
# 카카오 알림톡을 쓰는 경우에만 채널 ID 입력 (비워두면 일반 문자로 발송)
SOLAPI_SENDER_KEY=

# 이메일 인증용 Gmail 등
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_CODE_SECRET=jeolim-cabbage-secret
